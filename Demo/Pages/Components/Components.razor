@page "/components"
@inject IStringLocalizer<SharedResource> Localizer
@inject LanguageService LanguageService

<PageTitle>Blazor Kawaii - @Localizer["Components"]</PageTitle>

<MudText Typo="Typo.h3" HtmlTag="h1" GutterBottom="true">@Localizer["KawaiiComponents"]</MudText>
<MudText Typo="Typo.body1" Class="mud-text-secondary mb-4">
    @Localizer["ComponentsSubtitle"]
</MudText>

<MudGrid Spacing="2" Class="mb-4">
    <MudItem xs="12" md="6">
        <MudTextField T="string" @bind-Value="_searchTerm" Label="@Localizer["SearchComponents"]"
                      Variant="Variant.Outlined" Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true" Clearable="true" />
    </MudItem>
    <MudItem xs="12" md="6">
        <MudSelect T="Mood?" Label="@Localizer["FilterByMood"]" Value="_moodForAll" ValueChanged="SetMoodForAll"
                   Variant="Variant.Outlined" Clearable="true">
            @foreach (var mood in KawaiiCatalog.Moods)
            {
                <MudSelectItem Value="@((Mood?)mood)">@Localizer[$"Mood{mood}"]</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
</MudGrid>

@if (!FilteredComponents.Any())
{
    <div class="gallery-empty">
        <MagnifyingGlass Mood="Mood.Shocked" Size="120" Color="#C9B6F2" />
        <MudText Typo="Typo.body1" Class="mt-2">@Localizer["NoComponentsFound", _searchTerm]</MudText>
    </div>
}

<MudGrid Spacing="3">
    @foreach (var component in FilteredComponents)
    {
        var mood = _moods[component.Name];
        var moodLabel = Localizer[$"Mood{mood}"].Value;
        <MudItem xs="6" md="4" lg="3">
            <MudCard Class="component-showcase" Elevation="1">
                <button type="button" class="component-preview" @onclick="@(() => CycleMood(component))"
                        aria-label="@Localizer["ChangeMoodOf", component.Name, moodLabel]">
                    <span class="component-visual">
                        <DynamicComponent Type="@component.Type" Parameters="@(KawaiiCatalog.Parameters(mood, 100, _colors[component.Name]))" />
                    </span>
                    <span class="component-name">@component.Name</span>
                    <span class="mood-text">@moodLabel</span>
                    <span class="component-description">@Localizer[component.DescriptionKey]</span>
                </button>

                <div class="component-actions">
                    <MudTooltip Text="@Localizer["ViewCode"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Code"
                                       aria-label="@($"{Localizer["ViewCode"]} · {component.Name}")"
                                       OnClick="@(() => ShowCode(component))" />
                    </MudTooltip>
                    <MudTooltip Text="@Localizer["TryInPlayground"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Brush"
                                       aria-label="@($"{Localizer["TryInPlayground"]} · {component.Name}")"
                                       Href="@LanguageService.GetUrlWithLanguage($"playground?component={component.Name}&mood={mood}")" />
                    </MudTooltip>
                </div>
            </MudCard>
        </MudItem>
    }
</MudGrid>

<MudDialog @bind-Visible="_showCodeDialog" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6" HtmlTag="h2">@_selectedComponent?.Name · @Localizer["CodeExample"]</MudText>
    </TitleContent>
    <DialogContent>
        <CodeBlock Code="@GetCodeExample()" Language="razor" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showCodeDialog = false)">@Localizer["Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly DialogOptions _dialogOptions = new() { CloseOnEscapeKey = true, CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

    private string _searchTerm = "";
    private Mood? _moodForAll;
    private bool _showCodeDialog;
    private KawaiiEntry? _selectedComponent;

    // Each card starts in a different mood and color so the grid shows the whole range.
    private readonly Dictionary<string, Mood> _moods = KawaiiCatalog.All
        .Select((c, i) => (c.Name, Mood: KawaiiCatalog.Moods[i % KawaiiCatalog.Moods.Count]))
        .ToDictionary(x => x.Name, x => x.Mood);

    private readonly Dictionary<string, string> _colors = KawaiiCatalog.All
        .Select((c, i) => (c.Name, Color: KawaiiCatalog.Palette[i % KawaiiCatalog.Palette.Count]))
        .ToDictionary(x => x.Name, x => x.Color);

    private IEnumerable<KawaiiEntry> FilteredComponents => string.IsNullOrWhiteSpace(_searchTerm)
        ? KawaiiCatalog.All
        : KawaiiCatalog.All.Where(c =>
            c.Name.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase) ||
            Localizer[c.DescriptionKey].Value.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));

    private void SetMoodForAll(Mood? mood)
    {
        _moodForAll = mood;
        if (mood is { } m)
        {
            foreach (var name in _moods.Keys.ToList())
            {
                _moods[name] = m;
            }
        }
    }

    private void CycleMood(KawaiiEntry component)
    {
        var moods = KawaiiCatalog.Moods;
        var next = (moods.ToList().IndexOf(_moods[component.Name]) + 1) % moods.Count;
        _moods[component.Name] = moods[next];
        _colors[component.Name] = KawaiiCatalog.Palette[(KawaiiCatalog.Palette.ToList().IndexOf(_colors[component.Name]) + 1) % KawaiiCatalog.Palette.Count];
        _moodForAll = null;
    }

    private void ShowCode(KawaiiEntry component)
    {
        _selectedComponent = component;
        _showCodeDialog = true;
    }

    private string GetCodeExample() => _selectedComponent is null ? "" :
        CodeSamples.ComponentExample(_selectedComponent.Name, _moods[_selectedComponent.Name], _colors[_selectedComponent.Name],
            Localizer["BasicUsageComment"], Localizer["WithCustomPropertiesComment"], Localizer["AllMoodsExampleComment"]);
}
