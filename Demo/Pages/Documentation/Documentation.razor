@page "/documentation"
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<SharedResource> Localizer
@inject LanguageService LanguageService
@inject INuGetVersionService NuGetVersionService

<PageTitle>Blazor Kawaii - @Localizer["Documentation"]</PageTitle>

<MudText Typo="Typo.h3" HtmlTag="h1" GutterBottom="true">@Localizer["DocumentationTitle"]</MudText>
<MudText Typo="Typo.body1" Class="mud-text-secondary mb-6">
    @Localizer["DocumentationSubtitle"]
</MudText>

<MudGrid>
    <MudItem xs="12" md="3">
        <MudPaper Class="pa-4 doc-toc" Elevation="2">
            <nav aria-labelledby="toc-title">
                <MudText Typo="Typo.h6" HtmlTag="p" id="toc-title" GutterBottom="true">@Localizer["TableOfContents"]</MudText>
                <ul>
                    @foreach (var (id, key) in Sections)
                    {
                        <li>
                            <a href="@($"{LanguageService.GetUrlWithLanguage("documentation")}#{id}")"
                               @onclick="@(() => ScrollToSection(id))" @onclick:preventDefault="true">@Localizer[key]</a>
                        </li>
                    }
                </ul>
            </nav>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="9" Class="doc-content">
        <section id="getting-started" class="doc-section" tabindex="-1">
            <MudText Typo="Typo.h4" HtmlTag="h2" GutterBottom="true">@Localizer["GettingStarted"]</MudText>
            <MudText Typo="Typo.body1" GutterBottom="true">@Localizer["GettingStartedDesc"]</MudText>
            <MudText Typo="Typo.body1">@Localizer["GettingStartedDesc2"]</MudText>
        </section>

        <section id="installation" class="doc-section" tabindex="-1">
            <MudText Typo="Typo.h4" HtmlTag="h2" GutterBottom="true">@Localizer["Installation"]</MudText>
            <MudText Typo="Typo.body1" GutterBottom="true">@Localizer["InstallationDesc"]</MudText>

            <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Download" Class="mb-4">
                @Localizer["NuGetAvailable"]
            </MudAlert>

            <MudText Typo="Typo.h5" HtmlTag="h3" GutterBottom="true" Class="mt-4">@Localizer["InstallViaNuGet"]</MudText>

            <MudTabs Elevation="0" ApplyEffectsToContainer="true" Color="Color.Transparent" SliderColor="Color.Tertiary" Class="mb-4 doc-tabs">
                <MudTabPanel Text=".NET CLI">
                    <CodeBlock Language="bash" Code="dotnet add package BlazorKawaii" />
                </MudTabPanel>
                <MudTabPanel Text="Package Manager">
                    <CodeBlock Language="powershell" Code="Install-Package BlazorKawaii" />
                </MudTabPanel>
                <MudTabPanel Text="PackageReference">
                    <CodeBlock Language="xml" Code="@($"<PackageReference Include=\"BlazorKawaii\" Version=\"{_version ?? "*"}\" />")" />
                </MudTabPanel>
            </MudTabs>

            <MudText Typo="Typo.h6" HtmlTag="h3" GutterBottom="true">@Localizer["AddImports"]</MudText>
            <MudText Typo="Typo.body2" GutterBottom="true">@Localizer["AddToImportsFile"]</MudText>
            <CodeBlock Language="razor" CodeFile="code-samples/installation-imports.txt" />

            <MudText Typo="Typo.h6" HtmlTag="h3" GutterBottom="true" Class="mt-6">@Localizer["AlternativeMethod"]</MudText>
            <MudText Typo="Typo.body2" GutterBottom="true">@Localizer["IfYouPreferSource"]</MudText>
            <CodeBlock Language="bash" CodeFile="code-samples/installation-clone.txt" />
        </section>

        <section id="basic-usage" class="doc-section" tabindex="-1">
            <MudText Typo="Typo.h4" HtmlTag="h2" GutterBottom="true">@Localizer["BasicUsage"]</MudText>
            <MudText Typo="Typo.body1" GutterBottom="true">@Localizer["BasicUsageDesc"]</MudText>
            <CodeBlock Language="razor" CodeFile="code-samples/basic-usage.txt" />
            <MudText Typo="Typo.body1" Class="mt-4">@Localizer["BasicUsageDesc2"]</MudText>
        </section>

        <section id="component-props" class="doc-section" tabindex="-1">
            <MudText Typo="Typo.h4" HtmlTag="h2" GutterBottom="true">@Localizer["ComponentProperties"]</MudText>
            <MudText Typo="Typo.body1" GutterBottom="true">@Localizer["ComponentPropertiesDesc"]</MudText>

            <div class="table-scroll">
                <MudSimpleTable Hover="true" Bordered="true" Elevation="0" Class="mb-4">
                    <thead>
                        <tr>
                            <th scope="col">@Localizer["Property"]</th>
                            <th scope="col">@Localizer["Type"]</th>
                            <th scope="col">@Localizer["Default"]</th>
                            <th scope="col">@Localizer["Description"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (name, type, defaultValue, key) in Parameters)
                        {
                            <tr>
                                <td><code>@name</code></td>
                                <td><code>@type</code></td>
                                <td><code>@defaultValue</code></td>
                                <td>@Localizer[key]</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>

            <MudText Typo="Typo.h6" HtmlTag="h3" GutterBottom="true">@Localizer["ExampleWithAllProperties"]</MudText>
            <CodeBlock Language="razor" CodeFile="code-samples/example-all-properties.txt" />
        </section>

        <section id="moods" class="doc-section" tabindex="-1">
            <MudText Typo="Typo.h4" HtmlTag="h2" GutterBottom="true">@Localizer["Moods"]</MudText>
            <MudText Typo="Typo.body1" GutterBottom="true">@Localizer["MoodsDesc"]</MudText>

            <ul class="mood-grid">
                @foreach (var mood in KawaiiCatalog.Moods)
                {
                    <li class="mood-tile">
                        <Ghost Mood="@mood" Size="88" Color="#A6E191" />
                        <code>Mood.@mood</code>
                        <span class="mud-text-secondary">@Localizer[$"Mood{mood}"]</span>
                    </li>
                }
            </ul>
        </section>

        <section id="animation" class="doc-section" tabindex="-1">
            <MudText Typo="Typo.h4" HtmlTag="h2" GutterBottom="true">@Localizer["Animation"]</MudText>
            <MudText Typo="Typo.body1" GutterBottom="true">@Localizer["AnimationDesc"]</MudText>

            <ul class="mood-grid mb-6">
                @foreach (var mood in KawaiiCatalog.Moods)
                {
                    <li class="mood-tile">
                        <Ghost Mood="@mood" Size="88" Color="#A6E191" Animated="true" />
                        <code>Mood.@mood</code>
                        <span class="mud-text-secondary">@Localizer[$"Mood{mood}"]</span>
                    </li>
                }
            </ul>
            <CodeBlock Language="razor" CodeFile="code-samples/animation.txt" />
        </section>

        <section id="customization" class="doc-section" tabindex="-1">
            <MudText Typo="Typo.h4" HtmlTag="h2" GutterBottom="true">@Localizer["Customization"]</MudText>

            <MudText Typo="Typo.h6" HtmlTag="h3" GutterBottom="true" Class="mt-4">@Localizer["StylingWithCSS"]</MudText>
            <MudText Typo="Typo.body1" GutterBottom="true">@Localizer["StylingWithCSSDesc"]</MudText>
            <CodeBlock Language="razor" CodeFile="code-samples/styling-with-css.txt" />

            <MudText Typo="Typo.h6" HtmlTag="h3" GutterBottom="true" Class="mt-6">@Localizer["DynamicProperties"]</MudText>
            <MudText Typo="Typo.body1" GutterBottom="true">@Localizer["DynamicPropertiesDesc"]</MudText>
            <CodeBlock Language="razor" CodeFile="code-samples/dynamic-properties.txt" />
        </section>

        <section id="face-only" class="doc-section" tabindex="-1">
            <MudText Typo="Typo.h4" HtmlTag="h2" GutterBottom="true">@Localizer["FaceOnly"]</MudText>
            <MudText Typo="Typo.body1" GutterBottom="true">@Localizer["FaceOnlyDesc"]</MudText>

            <div class="face-overlay-row">
                <div class="face-overlay-demo">
                    <KawaiiFace Mood="Mood.Happy" Size="120"
                                Style="position:absolute; left:50%; top:45%; transform:translate(-50%,-50%)" />
                </div>
                <div class="face-overlay-demo face-overlay-demo--dark">
                    <KawaiiFace Color="#FFFFFF" Mood="Mood.Excited" BlushColor="#FF8FB1" Size="120"
                                Style="position:absolute; left:50%; top:45%; transform:translate(-50%,-50%)" />
                </div>
            </div>
            <CodeBlock Language="razor" CodeFile="code-samples/face-only.txt" />
        </section>

        <section id="examples" class="doc-section" tabindex="-1">
            <MudText Typo="Typo.h4" HtmlTag="h2" GutterBottom="true">@Localizer["Examples"]</MudText>

            <MudText Typo="Typo.h6" HtmlTag="h3" GutterBottom="true" Class="mt-4">@Localizer["LoadingStates"]</MudText>
            <CodeBlock Language="razor" CodeFile="code-samples/loading-states.txt" />

            <MudText Typo="Typo.h6" HtmlTag="h3" GutterBottom="true" Class="mt-6">@Localizer["ErrorStates"]</MudText>
            <CodeBlock Language="razor" CodeFile="code-samples/error-states.txt" />

            <MudText Typo="Typo.h6" HtmlTag="h3" GutterBottom="true" Class="mt-6">@Localizer["EmptyStates"]</MudText>
            <CodeBlock Language="razor" CodeFile="code-samples/empty-states.txt" />
        </section>

        <section id="api-reference" class="doc-section" tabindex="-1">
            <MudText Typo="Typo.h4" HtmlTag="h2" GutterBottom="true">@Localizer["APIReference"]</MudText>
            <MudText Typo="Typo.body1" GutterBottom="true">@Localizer["APIReferenceDesc"]</MudText>

            <div class="table-scroll">
                <MudSimpleTable Hover="true" Dense="true" Elevation="0" Class="mt-4 api-table">
                    <thead>
                        <tr>
                            <th scope="col"><span class="visually-hidden">@Localizer["Preview"]</span></th>
                            <th scope="col">@Localizer["Component"]</th>
                            <th scope="col">@Localizer["Description"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var component in KawaiiCatalog.All)
                        {
                            <tr>
                                <td><DynamicComponent Type="@component.Type" Parameters="@(KawaiiCatalog.Parameters(Mood.Blissful, 44, "#A6E191"))" /></td>
                                <td><code>&lt;@component.Name /&gt;</code></td>
                                <td>@Localizer[component.DescriptionKey]</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </div>

            <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="mt-4">
                @Localizer["PlaygroundCTA"]
                <a class="alert-link" href="@LanguageService.GetUrlWithLanguage("playground")">@Localizer["Playground"]</a>
                @Localizer["PlaygroundCTA2"]
            </MudAlert>
        </section>

        <section id="best-practices" class="doc-section" tabindex="-1">
            <MudText Typo="Typo.h4" HtmlTag="h2" GutterBottom="true">@Localizer["BestPractices"]</MudText>
            <MudText Typo="Typo.body1" GutterBottom="true">@Localizer["BestPracticesDesc"]</MudText>

            <MudList T="string" ReadOnly="true">
                @foreach (var key in new[] { "BestPractice1", "BestPractice2", "BestPractice3", "BestPractice4" })
                {
                    <MudListItem T="string" Icon="@Icons.Material.Filled.CheckCircle" IconColor="Color.Success">
                        <MudText Typo="Typo.body2">@Localizer[key]</MudText>
                    </MudListItem>
                }
            </MudList>
        </section>

        <section id="troubleshooting" class="doc-section" tabindex="-1">
            <MudText Typo="Typo.h4" HtmlTag="h2" GutterBottom="true">@Localizer["Troubleshooting"]</MudText>
            <MudText Typo="Typo.body1" GutterBottom="true">@Localizer["TroubleshootingDesc"]</MudText>

            <dl class="troubleshooting">
                @foreach (var i in new[] { 1, 2, 3 })
                {
                    <dt>@Localizer[$"CommonIssue{i}"]</dt>
                    <dd>@Localizer[$"CommonIssue{i}Solution"]</dd>
                }
            </dl>

            <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="mt-4">
                @Localizer["NeedMoreHelp"]
                <a class="alert-link" href="https://github.com/phmatray/BlazorKawaii/issues" target="_blank" rel="noopener">GitHub Issues</a>
            </MudAlert>
        </section>
    </MudItem>
</MudGrid>

@code {
    private static readonly (string Id, string Key)[] Sections =
    [
        ("getting-started", "GettingStarted"),
        ("installation", "Installation"),
        ("basic-usage", "BasicUsage"),
        ("component-props", "ComponentProperties"),
        ("moods", "Moods"),
        ("animation", "Animation"),
        ("customization", "Customization"),
        ("face-only", "FaceOnly"),
        ("examples", "Examples"),
        ("api-reference", "APIReference"),
        ("best-practices", "BestPractices"),
        ("troubleshooting", "Troubleshooting")
    ];

    // Mirrors the parameters of KawaiiComponentBase.
    private static readonly (string Name, string Type, string Default, string DescriptionKey)[] Parameters =
    [
        ("Size", "int", "240", "SizeDesc"),
        ("Mood", "Mood", "Mood.Blissful", "MoodDesc"),
        ("Color", "string?", "#A6E191", "ColorDesc"),
        ("Class", "string?", "null", "ClassDesc"),
        ("Style", "string?", "null", "StyleDesc"),
        ("SvgClass", "string?", "null", "SvgClassDesc"),
        ("SvgStyle", "string?", "null", "SvgStyleDesc"),
        ("Title", "string?", "null", "TitleDesc"),
        ("Animated", "bool", "false", "AnimatedDesc"),
        ("aria-*, data-*, …", "—", "—", "AdditionalAttributesDesc")
    ];

    private string? _version;

    protected override async Task OnInitializedAsync()
    {
        _version = await NuGetVersionService.GetLatestVersionAsync();
    }

    private async Task ScrollToSection(string sectionId)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("scrollToElement", sectionId);
        }
        catch (JSException ex)
        {
            Console.WriteLine($"Error scrolling to section {sectionId}: {ex.Message}");
        }
    }
}
