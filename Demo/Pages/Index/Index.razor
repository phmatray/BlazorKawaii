@page "/"
@inject IStringLocalizer<SharedResource> Localizer
@inject LanguageService LanguageService

<PageTitle>Blazor Kawaii - @Localizer["Home"]</PageTitle>

<section class="hero-section">
    <MudContainer MaxWidth="MaxWidth.Large">
        <MudGrid Spacing="6" Class="hero-grid">
            <MudItem xs="12" md="6" Class="hero-copy">
                <div class="hero-badges">
                    <a href="https://www.nuget.org/packages/BlazorKawaii" target="_blank" rel="noopener">
                        <img src="https://img.shields.io/nuget/v/BlazorKawaii?style=flat" alt="NuGet version" height="20" />
                    </a>
                    <a href="https://www.nuget.org/packages/BlazorKawaii" target="_blank" rel="noopener">
                        <img src="https://img.shields.io/nuget/dt/BlazorKawaii?style=flat" alt="NuGet downloads" height="20" />
                    </a>
                    <a href="https://github.com/phmatray/BlazorKawaii/blob/main/LICENSE" target="_blank" rel="noopener">
                        <img src="https://img.shields.io/badge/license-MIT-green?style=flat" alt="MIT license" height="20" />
                    </a>
                </div>

                <h1 class="hero-title">@Localizer["WelcomeToBlazorKawaii"]</h1>
                <p class="hero-subtitle">@Localizer["CuteCustomizableSVGComponents"]</p>

                <div class="hero-actions">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.Brush"
                               Href="@LanguageService.GetUrlWithLanguage("playground")">
                        @Localizer["TryPlayground"]
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Size="Size.Large"
                               StartIcon="@Icons.Material.Filled.MenuBook"
                               Href="@LanguageService.GetUrlWithLanguage("documentation")"
                               Class="hero-secondary-action">
                        @Localizer["ViewDocs"]
                    </MudButton>
                </div>
            </MudItem>

            <MudItem xs="12" md="6">
                <div class="mood-demo">
                    <div class="mood-demo-stage">
                        <div @key="@($"{_mascot.Name}-{_mood}-{_color}")" class="mood-demo-pop">
                            <DynamicComponent Type="@_mascot.Type" Parameters="@StageParameters" />
                        </div>
                    </div>

                    <div class="mood-demo-group" role="group" aria-labelledby="demo-mascot-label">
                        <span id="demo-mascot-label" class="mood-demo-label">@Localizer["Component"]</span>
                        <div class="mood-demo-options">
                            @foreach (var mascot in DemoMascots)
                            {
                                <button type="button" class="mascot-option" aria-pressed="@(mascot == _mascot ? "true" : "false")"
                                        aria-label="@mascot.Name" title="@mascot.Name" @onclick="@(() => _mascot = mascot)">
                                    <DynamicComponent Type="@mascot.Type" Parameters="@(KawaiiCatalog.Parameters(Mood.Blissful, 36, _color))" />
                                </button>
                            }
                        </div>
                    </div>

                    <div class="mood-demo-group" role="group" aria-labelledby="demo-mood-label">
                        <span id="demo-mood-label" class="mood-demo-label">@Localizer["Mood"]</span>
                        <div class="mood-demo-options">
                            @foreach (var mood in KawaiiCatalog.Moods)
                            {
                                <button type="button" class="mood-option" aria-pressed="@(mood == _mood ? "true" : "false")"
                                        @onclick="@(() => _mood = mood)">
                                    @Localizer[$"Mood{mood}"]
                                </button>
                            }
                        </div>
                    </div>

                    <div class="mood-demo-group" role="group" aria-labelledby="demo-color-label">
                        <span id="demo-color-label" class="mood-demo-label">@Localizer["Color"]</span>
                        <div class="mood-demo-options">
                            @foreach (var color in KawaiiCatalog.Palette)
                            {
                                <button type="button" class="color-option" aria-pressed="@(color == _color ? "true" : "false")"
                                        aria-label="@color" title="@color" style="--swatch: @color" @onclick="@(() => _color = color)"></button>
                            }
                        </div>
                    </div>

                    <CodeBlock Code="@DemoCode" Language="razor" />
                </div>
            </MudItem>
        </MudGrid>
    </MudContainer>
</section>

<MudContainer MaxWidth="MaxWidth.Large">
    <section class="home-section" aria-labelledby="ui-states-title">
        <MudText Typo="Typo.h4" HtmlTag="h2" id="ui-states-title" Align="Align.Center" GutterBottom="true">@Localizer["UiStatesTitle"]</MudText>
        <MudText Typo="Typo.body1" Align="Align.Center" Class="mud-text-secondary home-lead">@Localizer["UiStatesSubtitle"]</MudText>

        <MudGrid Spacing="4" Class="mt-6">
            @foreach (var state in UiStates)
            {
                <MudItem xs="12" sm="6" md="3">
                    <MudPaper Outlined="true" Class="ui-state">
                        <DynamicComponent Type="@state.Mascot.Type" Parameters="@(KawaiiCatalog.Parameters(state.Mood, 112, state.Color))" />
                        <MudText Typo="Typo.h6" HtmlTag="h3" Class="mt-2">@Localizer[state.TitleKey]</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@Localizer[state.TextKey]</MudText>
                        <code class="ui-state-code">&lt;@state.Mascot.Name Mood="Mood.@state.Mood"&nbsp;/&gt;</code>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    </section>

    <section class="home-section install-steps" aria-labelledby="install-title">
        <MudText Typo="Typo.h4" HtmlTag="h2" id="install-title" Align="Align.Center" GutterBottom="true">@Localizer["Installation"]</MudText>

        <ol class="steps">
            <li>
                <MudText Typo="Typo.h6" HtmlTag="h3">@Localizer["InstallViaNuGet"]</MudText>
                <CodeBlock Language="bash" Code="dotnet add package BlazorKawaii" />
            </li>
            <li>
                <MudText Typo="Typo.h6" HtmlTag="h3">@Localizer["AddToImports"]</MudText>
                <CodeBlock Language="razor" CodeFile="code-samples/installation-imports.txt" />
            </li>
            <li>
                <MudText Typo="Typo.h6" HtmlTag="h3">@Localizer["ThenUseComponents"]</MudText>
                <CodeBlock Language="razor" CodeFile="code-samples/quick-start-example.txt" />
            </li>
        </ol>
    </section>

    <section class="cta-section" aria-labelledby="cta-title">
        <MudText Typo="Typo.h4" HtmlTag="h2" id="cta-title" GutterBottom="true">@Localizer["ReadyToMakeYourAppKawaii"]</MudText>
        <MudText Typo="Typo.body1" Class="mb-6">@Localizer["ExploreAllComponents"]</MudText>
        <MudButton Variant="Variant.Filled"
                   Size="Size.Large"
                   StartIcon="@Icons.Material.Filled.Apps"
                   Href="@LanguageService.GetUrlWithLanguage("components")"
                   Class="cta-button">
            @Localizer["BrowseComponents"]
        </MudButton>
    </section>
</MudContainer>

@code {
    private record UiState(KawaiiEntry Mascot, Mood Mood, string Color, string TitleKey, string TextKey);

    private static readonly KawaiiEntry[] DemoMascots =
        new[] { "Cat", "Ghost", "RubberDuck", "Cloud", "Cookie", "Airplane" }.Select(n => KawaiiCatalog.Find(n)!).ToArray();

    private static readonly UiState[] UiStates =
    [
        new(KawaiiCatalog.Find("MagnifyingGlass")!, Mood.Shocked, "#C9B6F2", "StateNoResults", "StateNoResultsDesc"),
        new(KawaiiCatalog.Find("Cloud")!, Mood.Sad, "#83D1FB", "StateOffline", "StateOfflineDesc"),
        new(KawaiiCatalog.Find("Padlock")!, Mood.Ko, "#FF8EAD", "StateAccessDenied", "StateAccessDeniedDesc"),
        new(KawaiiCatalog.Find("Cookie")!, Mood.Blissful, "#FFB37A", "StateCookies", "StateCookiesDesc")
    ];

    private KawaiiEntry _mascot = DemoMascots[0];
    private Mood _mood = Mood.Blissful;
    private string _color = KawaiiCatalog.Palette[1];

    private Dictionary<string, object> StageParameters => KawaiiCatalog.Parameters(_mood, 200, _color);

    private string DemoCode => $"<{_mascot.Name} Mood=\"Mood.{_mood}\" Color=\"{_color}\" />";
}
