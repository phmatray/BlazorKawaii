@page "/playground"
@inject IStringLocalizer<SharedResource> Localizer

<PageTitle>Blazor Kawaii - @Localizer["Playground"]</PageTitle>

<MudText Typo="Typo.h3" HtmlTag="h1" GutterBottom="true">@Localizer["PlaygroundTitle"]</MudText>
<MudText Typo="Typo.body1" Class="mud-text-secondary mb-6">
    @Localizer["PlaygroundSubtitle"]
</MudText>

<div class="playground-layout">
    <MudPaper Class="pa-4 playground-preview-panel" Elevation="2">
        <MudText Typo="Typo.h6" HtmlTag="h2" GutterBottom="true">@Localizer["Preview"]</MudText>
        <div class="playground-preview">
            <div class="@($"playground-animation anim-{_animation}")">
                <DynamicComponent Type="@_component.Type" Parameters="@PreviewParameters" />
            </div>
        </div>
    </MudPaper>

    <MudPaper Class="pa-4 playground-controls" Elevation="2">
        <MudText Typo="Typo.h6" HtmlTag="h2" GutterBottom="true">@Localizer["CustomizeComponent"]</MudText>

        <MudSelect T="KawaiiEntry" Label="@Localizer["Component"]" @bind-Value="_component" ToStringFunc="@(c => c?.Name)"
                   Variant="Variant.Outlined" Class="mb-4">
            @foreach (var component in KawaiiCatalog.All)
            {
                <MudSelectItem Value="@component">@component.Name</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="Mood" Label="@Localizer["Mood"]" @bind-Value="_mood" ToStringFunc="@(m => Localizer[$"Mood{m}"].Value)"
                   Variant="Variant.Outlined" Class="mb-4">
            @foreach (var mood in KawaiiCatalog.Moods)
            {
                <MudSelectItem Value="@mood">@Localizer[$"Mood{mood}"]</MudSelectItem>
            }
        </MudSelect>

        <MudSlider T="int" @bind-Value="_size" Min="50" Max="400" Step="10" Color="Color.Tertiary" Class="mb-4"
                   aria-label="@Localizer["Size"]">
            @Localizer["SizePx", _size]
        </MudSlider>

        <MudColorPicker Label="@Localizer["Color"]" @bind-Text="_color" Variant="Variant.Outlined" Class="mb-4" />

        <MudDivider Class="my-4" />

        <MudText Typo="Typo.subtitle1" HtmlTag="h3" id="animation-label">@Localizer["AnimationEffects"]</MudText>
        <MudRadioGroup T="string" @bind-Value="_animation" aria-labelledby="animation-label">
            <MudRadio Value="@("none")" Color="Color.Tertiary">@Localizer["NoAnimation"]</MudRadio>
            <MudRadio Value="@("rotation")" Color="Color.Tertiary">@Localizer["Rotation"]</MudRadio>
            <MudRadio Value="@("bounce")" Color="Color.Tertiary">@Localizer["Bounce"]</MudRadio>
            <MudRadio Value="@("pulse")" Color="Color.Tertiary">@Localizer["Pulse"]</MudRadio>
        </MudRadioGroup>

        <MudButton Variant="Variant.Outlined" Color="Color.Tertiary" FullWidth="true"
                   StartIcon="@Icons.Material.Filled.RestartAlt"
                   Class="mt-4" OnClick="ResetToDefaults">
            @Localizer["ResetToDefaults"]
        </MudButton>
    </MudPaper>

    <MudPaper Class="pa-4 playground-code" Elevation="2">
        <MudText Typo="Typo.h6" HtmlTag="h2" GutterBottom="true">@Localizer["GeneratedCode"]</MudText>
        <CodeBlock Code="@GeneratedCode" Language="razor" />
    </MudPaper>
</div>

@code {
    private const string DefaultColor = "#FFD882";
    private const int DefaultSize = 240;

    /// <summary>Mascot to open, e.g. from a gallery card (<c>?component=Cookie</c>).</summary>
    [SupplyParameterFromQuery(Name = "component")]
    public string? ComponentQuery { get; set; }

    /// <summary>Mood to open with (<c>?mood=Happy</c>).</summary>
    [SupplyParameterFromQuery(Name = "mood")]
    public string? MoodQuery { get; set; }

    private KawaiiEntry _component = KawaiiCatalog.Find("Cat")!;
    private Mood _mood = Mood.Blissful;
    private int _size = DefaultSize;
    private string _color = DefaultColor;
    private string _animation = "none";

    protected override void OnParametersSet()
    {
        _component = KawaiiCatalog.Find(ComponentQuery) ?? _component;
        if (Enum.TryParse<Mood>(MoodQuery, ignoreCase: true, out var mood))
        {
            _mood = mood;
        }
    }

    private Dictionary<string, object> PreviewParameters
    {
        get
        {
            var parameters = KawaiiCatalog.Parameters(_mood, _size, _color);
            parameters[nameof(KawaiiComponentBase.Class)] = "playground-mascot";
            return parameters;
        }
    }

    private string GeneratedCode => $@"@using BlazorKawaii.Components
@using BlazorKawaii.Common

<{_component.Name} Mood=""Mood.{_mood}"" Size=""{_size}"" Color=""{_color}"" />";

    private void ResetToDefaults()
    {
        _component = KawaiiCatalog.Find("Cat")!;
        _mood = Mood.Blissful;
        _size = DefaultSize;
        _color = DefaultColor;
        _animation = "none";
    }
}
