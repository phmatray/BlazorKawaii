@inject IJSRuntime JSRuntime
@inject HttpClient HttpClient
@inject IStringLocalizer<SharedResource> Localizer
@inject ISnackbar Snackbar

<MudPaper Class="code-block-container" Outlined="true" Elevation="0">
    <div class="code-block-header">
        <MudText Typo="Typo.caption" Class="code-language-label">@GetLanguageLabel()</MudText>
        <MudSpacer />
        @if (ShowCopyButton)
        {
            <MudButton Variant="Variant.Text"
                       Size="Size.Small"
                       StartIcon="@(_codeCopied ? Icons.Material.Filled.Done : Icons.Material.Filled.ContentCopy)"
                       Color="@(_codeCopied ? Color.Success : Color.Default)"
                       OnClick="CopyCode"
                       Class="code-copy-btn">
                @(_codeCopied ? Localizer["Copied"] : Localizer["CopyToClipboard"])
            </MudButton>
        }
    </div>
    <div class="code-block-content">
        <pre class="@($"language-{Language}")"><code class="@($"language-{Language}")">@Rendered</code></pre>
    </div>
</MudPaper>

@code {
    [Parameter] public string? Code { get; set; }
    [Parameter] public string? CodeFile { get; set; }
    [Parameter] public string Language { get; set; } = "csharp";
    [Parameter] public bool ShowCopyButton { get; set; } = true;

    private bool _codeCopied;
    private string _displayCode = "";
    private string? _loadedFile;
    private MarkupString? _highlighted;

    private MarkupString Rendered => _highlighted ?? new MarkupString(System.Net.WebUtility.HtmlEncode(_displayCode));

    protected override async Task OnParametersSetAsync()
    {
        var code = Code ?? "";
        if (!string.IsNullOrEmpty(CodeFile))
        {
            if (CodeFile != _loadedFile)
            {
                try
                {
                    _displayCode = await HttpClient.GetStringAsync(CodeFile);
                }
                catch
                {
                    _displayCode = $"// Error loading code from {CodeFile}";
                }
                _loadedFile = CodeFile;
                _highlighted = await HighlightAsync(_displayCode);
            }
            return;
        }

        if (code != _displayCode || _highlighted is null)
        {
            _displayCode = code;
            _highlighted = await HighlightAsync(code);
        }
    }

    // Prism returns escaped, highlighted HTML; null falls back to plain text.
    private async Task<MarkupString?> HighlightAsync(string code)
    {
        try
        {
            var html = await JSRuntime.InvokeAsync<string?>("PrismWrapper.highlight", code, Language);
            return html is null ? null : new MarkupString(html);
        }
        catch (JSException)
        {
            return null;
        }
    }

    private async Task CopyCode()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", _displayCode);
        }
        catch (JSException)
        {
            // Clipboard access is refused on http, in some iframes and under some iOS settings.
            Snackbar.Add(Localizer["CopyFailed"], Severity.Warning);
            return;
        }

        _codeCopied = true;
        StateHasChanged();

        await Task.Delay(2000);
        _codeCopied = false;
        StateHasChanged();
    }

    private string GetLanguageLabel()
    {
        return Language switch
        {
            "csharp" => "C#",
            "razor" => "Razor",
            "html" => "HTML",
            "css" => "CSS",
            "javascript" or "js" => "JavaScript",
            "json" => "JSON",
            "xml" => "XML",
            "bash" => "Bash",
            "powershell" => "PowerShell",
            _ => Language.ToUpper()
        };
    }
}
