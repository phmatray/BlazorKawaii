@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Localizer
@using System.Globalization
@using Microsoft.AspNetCore.WebUtilities

<MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
    <ActivatorContent>
        <MudIconButton Icon="@Icons.Material.Filled.Language" Color="Color.Inherit" aria-label="@Localizer["Language"]" />
    </ActivatorContent>
    <ChildContent>
        @foreach (var (langCode, name) in Languages)
        {
            <MudMenuItem OnClick="@(() => ChangeCulture(langCode))">
                <div class="d-flex align-center gap-2" lang="@langCode">
                    <MudIcon Icon="@(CurrentCulture == langCode ? Icons.Material.Filled.Check : Icons.Material.Filled.Circle)" Size="Size.Small" />
                    @name
                </div>
            </MudMenuItem>
        }
    </ChildContent>
</MudMenu>

@code {
    private static readonly (string Code, string Name)[] Languages =
        [("en", "English"), ("fr", "Français"), ("es", "Español"), ("nl", "Nederlands")];

    private string CurrentCulture => CultureInfo.CurrentUICulture.Name;

    private async Task ChangeCulture(string culture)
    {
        // Save to localStorage for persistence
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "culture", culture);

        // Navigate with the new culture in the URL
        var uri = new Uri(Navigation.Uri);
        var newUri = QueryHelpers.AddQueryString(uri.GetLeftPart(UriPartial.Path), "lang", culture);
        Navigation.NavigateTo(newUri, forceLoad: true);
    }
}
